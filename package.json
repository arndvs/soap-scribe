{
  "name": "soap-scribe",
  "private": true,
  "version": "0.1.0",
  "description": "An AI scribe that drafts SOAP notes from recorded visits; the clinician reviews and signs.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check:files": "node scripts/check-forbidden-files.mjs",
    "ci": "pnpm check:files && pnpm typecheck && pnpm test",
    "demo": "pnpm --filter @soap-scribe/extension build:demo && pnpm --filter @soap-scribe/server demo",
    "test:e2e": "pnpm --filter @soap-scribe/e2e test:e2e"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
