# Copy to .env for local development. Real values live in AWS Secrets Manager and GitHub Actions secrets.

# --- Server: secrets ---
MONGODB_URI=mongodb://localhost:27017/soap-scribe
POCKET_API_KEY=pk_replace_me
POCKET_WEBHOOK_SECRET=replace_me
# sha256 hex of the extension token. Generate both with: pnpm --filter @soap-scribe/server token
EXTENSION_TOKEN_HASH=replace_me

# --- Server: config ---
PORT=8787
POCKET_API_BASE=https://public.heypocketai.com/api/v1
LLM_PROVIDER=fake
AWS_REGION=us-west-2
LLM_MODEL_EXTRACT=replace_with_bedrock_model_id
LLM_MODEL_COMPOSE=replace_with_bedrock_model_id
ALERT_EMAIL=
ALERT_FROM_EMAIL=
DRAFT_TTL_HOURS=24
PRACTICE_TIMEZONE=America/Los_Angeles

# --- Extension build (non-secret allowlist only) ---
API_URL=http://localhost:8787
JANE_HOST=example.jane.app
